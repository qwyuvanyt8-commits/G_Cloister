{
  "name": "g-cloister",
  "version": "0.1.0",
  "private": true,
  "description": "G_Cloister — real-time room-based file storage on the host's Google Drive",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix server run build && npm --prefix web run build",
    "start": "concurrently -n server,web -c blue,magenta \"npm:start:server\" \"npm:start:web\"",
    "start:server": "npm --prefix server run start",
    "start:web": "npm --prefix web run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
